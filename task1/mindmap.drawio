        <mxCell id="9pjqNcquVefBaI2k0oGx-1893" value="&amp;nbsp;Значительный&amp;nbsp;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontColor=#FF8000;fontSize=13;" vertex="1" connectable="0" parent="9pjqNcquVefBaI2k0oGx-1892">
